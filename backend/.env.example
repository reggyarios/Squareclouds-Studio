# Contoh konfigurasi email untuk Creator Portal v2.1 (undangan kreator).
# Salin variabel di bawah ke backend/.env lalu isi nilainya. Jangan commit .env.

# Server SMTP. Kosongkan SMTP_HOST untuk mode dev: email tidak dikirim,
# isinya (termasuk link undangan) hanya dicetak ke log backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Pengirim email. Kosong = pakai SMTP_USER.
MAIL_FROM="Squareclouds Studio <contact@squarecloudsmc.com>"

# Alamat portal kreator, dipakai untuk link undangan ({PORTAL_URL}/register?token=...).
PORTAL_URL=https://creator.squarecloudsmc.com

# Arsip slip payout PDF di Google Drive (backend/gdrive.py). Kosongkan salah
# satunya untuk menonaktifkan: payout tetap tercatat, slip tidak diarsipkan,
# dan riwayat admin menampilkan "Drive: gagal" dengan tombol Upload ulang.
# GDRIVE_SA_FILE   path file JSON kunci service account (simpan di luar repo).
# GDRIVE_FOLDER_ID ID folder induk, harus di Shared Drive (service account tidak
#                  punya kuota sendiri). Tambahkan email service account sebagai
#                  anggota Shared Drive dengan peran Content manager. Slip
#                  disimpan di subfolder per periode, mis. 2026-08/.
GDRIVE_SA_FILE=
GDRIVE_FOLDER_ID=
